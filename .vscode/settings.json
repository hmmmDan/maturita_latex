{
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "/usr/sbin/xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeX",
            "tools": ["xelatex"]
        }
    ],
    "latex-workshop.latex.mainRecipe": "XeLaTeX"
}
