{
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "/usr/sbin/xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        },
        {
            "name": "bibtex",
            "command": "/usr/bin/bibtex",
            "args": ["%DOCFILE%"]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeX + BibTeX (biblatex)",
            "tools": ["xelatex", "bibtex", "xelatex", "xelatex"]
        }
    ],
    "latex-workshop.latex.mainRecipe": "XeLaTeX + BibTeX (biblatex)"
}
